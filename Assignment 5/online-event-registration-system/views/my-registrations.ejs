<!DOCTYPE html><html><head><title>My Registrations</title><link rel="stylesheet" href="/style.css"></head><body><nav><b>Event Management System</b><span><a href="/events">Events</a> | <a href="/registrations/my">My Registrations</a> | <a href="/logout">Logout</a></span></nav><div class="dashboard"><h1>My Registrations</h1><% if(!registrations.length){ %><div class="card"><p>You have not registered for any event yet.</p><a class="btn" href="/events">Browse Events</a></div><% } %><% registrations.forEach(r=>{ %><div class="order"><h2><%= r.event?r.event.title:"Event Deleted" %></h2><% if(r.event){ %><p><b>Date:</b> <%= new Date(r.event.date).toLocaleString() %></p><p><b>Venue:</b> <%= r.event.venue %></p><% } %><p><b>Attendee:</b> <%= r.attendeeName %></p><p><b>Status:</b> <span class="status"><%= r.status %></span></p><p><b>Registered:</b> <%= r.createdAt.toLocaleString() %></p><% if(r.status!=="Cancelled"){ %><form action="/registrations/cancel/<%= r._id %>" method="POST"><button class="danger">Cancel Registration</button></form><% } %></div><% }) %></div></body></html>