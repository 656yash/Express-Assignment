<!DOCTYPE html><html><head><title>Event Form</title><link rel="stylesheet" href="/style.css"></head><body><div class="container"><div class="card wide"><h1><%= mode==="add"?"Create Event":"Update Event" %></h1><% errors.forEach(e=>{ %><div class="error"><%= e.msg %></div><% }) %><form action="<%= mode==="add"?"/events/add":"/events/edit/"+event._id %>" method="POST"><label>Event Title</label><input name="title" value="<%= event.title||"" %>" required><label>Description</label><textarea name="description" required><%= event.description||"" %></textarea><label>Date and Time</label><input type="datetime-local" name="date" value="<%= event.date?new Date(event.date).toISOString().slice(0,16):"" %>" required><label>Venue</label><input name="venue" value="<%= event.venue||"" %>" required><label>Category</label><input name="category" value="<%= event.category||"" %>" required><label>Capacity</label><input type="number" name="capacity" min="1" value="<%= event.capacity||"" %>" required><label>Registration Fee (₹)</label><input type="number" step="0.01" min="0" name="registrationFee" value="<%= event.registrationFee??"" %>" required><button>Save Event</button></form><p><a href="/events">← Back to Events</a></p></div></div></body></html>