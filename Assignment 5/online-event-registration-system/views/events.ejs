<!DOCTYPE html><html><head><title>Events</title><link rel="stylesheet" href="/style.css"></head><body><nav><b>Event Management System</b><span><a href="/events">Events</a> | <a href="/registrations/my">My Registrations</a><% if(currentUser&&currentUser.role==="admin"){ %> | <a href="/registrations/admin">Registrations</a><% } %> | <a href="/logout">Logout</a></span></nav><div class="dashboard"><div class="header"><div><h1>Available Events</h1><p>Welcome, <%= currentUser.name %></p></div><% if(currentUser.role==="admin"){ %><a class="btn" href="/events/add">+ Add Event</a><% } %></div><div class="grid"><% events.forEach(event=>{ %><div class="event"><div class="badge"><%= event.category %></div><h2><%= event.title %></h2><p><%= event.description %></p><p><b>Date:</b> <%= new Date(event.date).toLocaleString() %></p><p><b>Venue:</b> <%= event.venue %></p><p><b>Capacity:</b> <%= event.capacity %></p><p><b>Registration Fee:</b> ₹<%= event.registrationFee.toFixed(2) %></p><% if(currentUser.role==="admin"){ %><a class="btn" href="/events/edit/<%= event._id %>">Edit</a><form class="inline" action="/events/delete/<%= event._id %>" method="POST"><button class="danger" onclick="return confirm('Delete this event?')">Delete</button></form><% }else{ %><a class="btn" href="/registrations/new/<%= event._id %>">Register Now</a><% } %></div><% }) %></div></div></body></html>