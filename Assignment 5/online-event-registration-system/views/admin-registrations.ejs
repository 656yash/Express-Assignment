<!DOCTYPE html><html><head><title>Manage Registrations</title><link rel="stylesheet" href="/style.css"></head><body><nav><b>Admin - Event Management</b><span><a href="/events">Events</a> | <a href="/registrations/admin">Registrations</a> | <a href="/logout">Logout</a></span></nav><div class="dashboard"><h1>All Registrations</h1><div class="table-container"><table><tr><th>Attendee</th><th>Email</th><th>Event</th><th>Date</th><th>Status</th><th>Update</th></tr><% registrations.forEach(r=>{ %><tr><td><%= r.attendeeName %></td><td><%= r.attendeeEmail %></td><td><%= r.event?r.event.title:"Deleted Event" %></td><td><%= r.event?new Date(r.event.date).toLocaleDateString():"-" %></td><td><%= r.status %></td><td><form action="/registrations/admin/<%= r._id %>/status" method="POST"><select name="status"><% ["Registered","Confirmed","Cancelled"].forEach(s=>{ %><option <%= s===r.status?"selected":"" %>><%= s %></option><% }) %></select><button>Save</button></form></td></tr><% }) %></table></div></div></body></html>