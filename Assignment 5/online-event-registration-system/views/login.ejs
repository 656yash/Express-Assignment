<!DOCTYPE html><html><head><title>Login</title><link rel="stylesheet" href="/style.css"></head><body><div class="container"><div class="card"><h1>Event Registration</h1><h2>Login</h2><% errors.forEach(e=>{ %><div class="error"><%= e.msg %></div><% }) %><form action="/login" method="POST"><label>Email</label><input type="email" name="email" required><label>Password</label><input type="password" name="password" required><button>Login</button></form><p>New user? <a href="/register">Create an account</a></p></div></div></body></html>