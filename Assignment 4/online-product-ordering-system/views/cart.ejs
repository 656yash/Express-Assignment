<!DOCTYPE html>
<html><head><title>Cart</title><link rel="stylesheet" href="/style.css"></head>
<body><nav><b>Online Product Store</b><span><a href="/products">Products</a> | <a href="/orders">Orders</a> | <a href="/logout">Logout</a></span></nav>
<div class="dashboard"><h1>Shopping Cart</h1>
<% if(!cart.items.length){ %><div class="card"><p>Your cart is empty.</p><a class="btn" href="/products">Browse Products</a></div><% } else { %>
<div class="table-container"><table><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th>Action</th></tr>
<% cart.items.forEach(i => { %><tr><td><%= i.product.name %></td><td>₹<%= i.product.price.toFixed(2) %></td><td><form class="inline" action="/cart/update/<%= i.product._id %>" method="POST"><input class="qty" type="number" min="1" max="<%= Math.min(i.product.quantity,100) %>" name="quantity" value="<%= i.quantity %>"><button>Update</button></form></td><td>₹<%= (i.product.price*i.quantity).toFixed(2) %></td><td><form action="/cart/remove/<%= i.product._id %>" method="POST"><button class="danger">Remove</button></form></td></tr><% }) %>
</table></div><h2>Total: ₹<%= total.toFixed(2) %></h2>
<div class="card"><h2>Checkout</h2><form action="/orders/place" method="POST"><label>Name</label><input name="name" value="<%= user.name %>" required><label>Email</label><input type="email" name="email" value="<%= user.email %>" required><label>Mobile</label><input name="mobile" value="<%= user.mobile %>" required><label>Address</label><textarea name="address" required><%= user.address %></textarea><button>Place Order</button></form></div>
<% } %></div></body></html>