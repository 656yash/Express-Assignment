<!DOCTYPE html>
<html><head><title><%= mode==="add" ? "Add Product" : "Edit Product" %></title><link rel="stylesheet" href="/style.css"></head>
<body><div class="container"><div class="card wide">
<h1><%= mode==="add" ? "Add Product" : "Edit Product" %></h1>
<% errors.forEach(e => { %><div class="error"><%= e.msg %></div><% }) %>
<form action="<%= mode==='add' ? '/products/add' : '/products/edit/'+product._id %>" method="POST">
<label>Name</label><input name="name" value="<%= product.name || '' %>" required>
<label>Description</label><textarea name="description" required><%= product.description || '' %></textarea>
<label>Price (₹)</label><input type="number" step="0.01" min="0.01" name="price" value="<%= product.price || '' %>" required>
<label>Quantity</label><input type="number" min="0" name="quantity" value="<%= product.quantity ?? '' %>" required>
<label>Category</label><input name="category" value="<%= product.category || '' %>" required>
<label>Image URL (optional)</label><input type="url" name="image" value="<%= product.image || '' %>">
<button>Save Product</button>
</form><p><a href="/products">← Back</a></p>
</div></div></body></html>