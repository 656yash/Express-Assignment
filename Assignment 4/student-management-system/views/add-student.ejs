<!DOCTYPE html><html><head><title>Add Student</title><link rel="stylesheet" href="/style.css"></head><body><div class="container"><div class="card"><h1>Add Student</h1><% if(errors&&errors.length){ %><div class="error"><% errors.forEach(error=>{ %><p><%= error.msg %></p><% }) %></div><% } %><form action="/students/add" method="POST"><label>Name</label><input name="name" value="<%= oldData.name||'' %>" required><label>Email</label><input type="email" name="email" value="<%= oldData.email||'' %>" required><label>Mobile Number</label><input name="mobile" value="<%= oldData.mobile||'' %>" required><label>Age</label><input type="number" name="age" value="<%= oldData.age||'' %>" min="16" max="100" required><label>Course</label><input name="course" value="<%= oldData.course||'' %>" required><button type="submit">Add Student</button></form><br><a href="/students/dashboard">← Back to Dashboard</a></div></div></body></html>
