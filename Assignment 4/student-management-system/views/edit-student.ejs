<!DOCTYPE html><html><head><title>Edit Student</title><link rel="stylesheet" href="/style.css"></head><body><div class="container"><div class="card"><h1>Edit Student</h1><% if(errors&&errors.length){ %><div class="error"><% errors.forEach(error=>{ %><p><%= error.msg %></p><% }) %></div><% } %><form action="/students/edit/<%= student._id %>" method="POST"><label>Name</label><input name="name" value="<%= student.name %>" required><label>Email</label><input type="email" name="email" value="<%= student.email %>" required><label>Mobile</label><input name="mobile" value="<%= student.mobile %>" required><label>Age</label><input type="number" name="age" value="<%= student.age %>" min="16" max="100" required><label>Course</label><input name="course" value="<%= student.course %>" required><button type="submit">Update Student</button></form><br><a href="/students/dashboard">← Back to Dashboard</a></div></div></body></html>
