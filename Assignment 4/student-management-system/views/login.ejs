<!DOCTYPE html><html><head><title>Student Management - Login</title><link rel="stylesheet" href="/style.css"></head><body><div class="container"><div class="card"><h1>Student Management System</h1><h2>Login</h2><% if(typeof errors!=='undefined'){ %><div class="error"><% errors.forEach(error=>{ %><p><%= error.msg %></p><% }) %></div><% } %><form action="/login" method="POST"><label>Email</label><input type="email" name="email" required><label>Password</label><input type="password" name="password" required><button type="submit">Login</button></form><p>Don't have an account? <a href="/register">Register</a></p></div></div></body></html>
