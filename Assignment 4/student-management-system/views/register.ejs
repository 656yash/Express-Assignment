<!DOCTYPE html><html><head><title>Register</title><link rel="stylesheet" href="/style.css"></head><body><div class="container"><div class="card"><h1>Create Account</h1><% if(typeof errors!=='undefined'){ %><div class="error"><% errors.forEach(error=>{ %><p><%= error.msg %></p><% }) %></div><% } %><form action="/register" method="POST"><label>Name</label><input type="text" name="name" required><label>Email</label><input type="email" name="email" required><label>Password</label><input type="password" name="password" required><button type="submit">Register</button></form><p>Already have an account? <a href="/login">Login</a></p></div></div></body></html>
