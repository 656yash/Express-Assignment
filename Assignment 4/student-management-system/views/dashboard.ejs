<!DOCTYPE html><html><head><title>Student Dashboard</title><link rel="stylesheet" href="/style.css"></head><body><nav><strong>Student Management System</strong><span>Welcome, <%= user.name %> | <a href="/logout">Logout</a></span></nav><div class="dashboard"><div class="header"><div><h1>Student Dashboard</h1><p>Manage student records</p></div><% if(user.role==='admin'){ %><a href="/students/add" class="btn">+ Add Student</a><% } %></div><div class="table-container"><table><thead><tr><th>Name</th><th>Email</th><th>Mobile</th><th>Age</th><th>Course</th><% if(user.role==='admin'){ %><th>Actions</th><% } %></tr></thead><tbody><% if(students.length===0){ %><tr><td colspan="6">No students found.</td></tr><% } %><% students.forEach(student=>{ %><tr><td><%= student.name %></td><td><%= student.email %></td><td><%= student.mobile %></td><td><%= student.age %></td><td><%= student.course %></td><% if(user.role==='admin'){ %><td><a href="/students/edit/<%= student._id %>" class="edit">Edit</a><form action="/students/delete/<%= student._id %>" method="POST" style="display:inline" onsubmit="return confirm('Delete this student?')"><button type="submit" class="delete">Delete</button></form></td><% } %></tr><% }) %></tbody></table></div></div></body></html>
